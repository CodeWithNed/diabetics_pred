# Application Configuration
FLASK_ENV=production
DEBUG=False
PORT=5000

 # Docker Configuration
# Set to 'false' if you want to use external PostgreSQL (local install or remote)
USE_POSTGRES_CONTAINER=true

# PostgreSQL Database Configuration
POSTGRES_USER=diabetesapp
POSTGRES_PASSWORD=diabetesapp123
POSTGRES_DB=diabetes_db

# For Docker container PostgreSQL:
DATABASE_URL=postgresql://diabetesapp:diabetesapp123@postgres:5432/diabetes_db

# For local PostgreSQL on macOS/Linux:
# DATABASE_URL=postgresql://diabetesapp:diabetesapp123@localhost:5432/diabetes_db

# For local PostgreSQL from Docker on macOS/Windows:
# DATABASE_URL=postgresql://diabetesapp:diabetesapp123@host.docker.internal:5432/diabetes_db

# External PostgreSQL Configuration (when USE_POSTGRES_CONTAINER=false)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# Groq AI Configuration
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Dataset and Upload Configuration
DATASET_PATH=data/datasets
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png

# Rate Limiting
RATE_LIMIT=100
RATE_LIMIT_PERIOD=60
